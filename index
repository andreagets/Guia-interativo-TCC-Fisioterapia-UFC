        <img class="ufc-crest" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAF8AAABPCAIAAAAC+I45AAAJNElEQVR4nO2dbVAU5xnHf3dweV4q" alt="Brasão Oficial da Universidade Federal do Ceará">
